# ---- Required (validated at boot; the process exits if any is missing) ----

# PostgreSQL connection string.
# Neon: use the POOLED host and append ?sslmode=require&pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://user:password@localhost:5432/devpulse"

# Signing secret for session tokens and the OAuth state parameter.
# Rotating this logs every user out.
JWT_SECRET="replace-with-a-long-random-string"

# GitHub OAuth App credentials — https://github.com/settings/developers
# An OAuth App allows exactly ONE callback URL, so local and production need
# SEPARATE apps. The callback must byte-for-byte equal:
#   ${API_BASE_URL}/api/platforms/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# AES-256 key for encrypting platform tokens at rest.
# Must be EXACTLY 64 hex characters (32 bytes). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this invalidates every stored GitHub token — users must reconnect.
ENCRYPTION_KEY=""

# Public base URL of this API — used to build the OAuth callback URL.
# No trailing slash. Must match the GitHub OAuth App's callback origin.
API_BASE_URL="http://localhost:3000"


# ---- Optional (defaults shown) ----

NODE_ENV="development"
PORT=3000

# Direct (non-pooled) database URL, used only by `prisma migrate`.
# Defaults to DATABASE_URL when unset. Only Neon needs the two to differ:
# migrations need advisory locks that PgBouncer's transaction mode cannot hold.
# DIRECT_URL=""

# Where the OAuth flow sends the browser after a successful connect.
FRONTEND_URL="http://localhost:5173"

# Full Redis URL. Managed providers (Upstash) require rediss:// for TLS:
#   rediss://default:<password>@<id>.upstash.io:6379
# When unset, built from REDIS_HOST/REDIS_PORT below.
# REDIS_URL=""

# Legacy local-development fallback, ignored when REDIS_URL is set.
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379

# Comma-separated list of exact browser origins allowed to call this API.
# Defaults to FRONTEND_URL when unset.
CORS_ORIGINS="http://localhost:5173"

# Regex for ephemeral preview origins (Vercel gives each deploy a new URL).
# Anchor it to your project — a bare .vercel.app would allow anyone's project.
# CORS_PREVIEW_PATTERN="^https://devpulse-[a-z0-9-]+\.vercel\.app$"

# Shared secret for POST /api/sync/run-all, called by the scheduled workflow.
# When unset that endpoint refuses all requests rather than running open.
# CRON_SECRET=""

# Run the BullMQ worker inside the API process instead of as its own service.
# Set to "true" only on hosts without a background-worker product (Render free).
# Locally, leave this false and run `npm run worker` in a second terminal.
RUN_WORKER_IN_PROCESS=false

# Jobs processed simultaneously. Lower it when the worker shares a CPU with HTTP.
SYNC_WORKER_CONCURRENCY=5

# Set to "false" to disable scheduled syncs and remove the scheduler from Redis.
# Production uses "false": a spun-down free instance fires no repeatable jobs,
# so GitHub Actions calls /api/sync/run-all instead.
SYNC_SCHEDULE_ENABLED=true

# Cron pattern for the fan-out tick. An invalid pattern exits the worker on boot.
SYNC_SCHEDULE_CRON="0 */6 * * *"
SYNC_SCHEDULE_TIMEZONE="UTC"

# Users enqueued per addBulk batch during fan-out.
SYNC_FANOUT_BATCH_SIZE=500
